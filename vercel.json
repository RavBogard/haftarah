{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/web-build.mjs",
  "outputDirectory": "site/dist",
  "framework": null,
  "cleanUrls": false,
  "trailingSlash": false,
  "installCommand": "npm --prefix api ci --no-audit --no-fund",
  "functions": {
    "api/mcp.mjs": { "maxDuration": 300, "memory": 3009, "includeFiles": "{template/**,assets/logo.png,bibliography/**,customs/**,data/**,api/node_modules/@sparticuz/chromium/bin/**}" },
    "api/prefetch.mjs": { "maxDuration": 300, "includeFiles": "{customs/**,bibliography/**,data/**}" },
    "api/oauth.mjs": { "maxDuration": 15 },
    "api/draft.mjs": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/prefetch", "schedule": "0 3 * * 4" },
    { "path": "/api/prefetch", "schedule": "0 4 * * 4" }
  ],
  "rewrites": [
    { "source": "/.well-known/oauth-authorization-server/:path*", "destination": "/api/oauth?action=metadata" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth?action=metadata" },
    { "source": "/.well-known/oauth-protected-resource/:path*", "destination": "/api/oauth?action=resource" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth?action=resource" },
    { "source": "/oauth/:action(authorize|token|register|revoke)", "destination": "/api/oauth?action=:action" },
    { "source": "/api/auth/google/callback", "destination": "/api/oauth?action=callback" },
    { "source": "/api/draft/:slug/:file", "destination": "/api/draft?slug=:slug&file=:file" },
    { "source": "/data/:path*", "destination": "https://wogdaqvpmtfjkrmy.public.blob.vercel-storage.com/:path*" },
    { "source": "/:slug(\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+)", "destination": "/sheet.html" },
    { "source": "/:year(\\d{4})/:parashah(bereshit|noach|lech-lecha|vayera|chayei-sara|toldot|vayetzei|vayishlach|vayeshev|miketz|vayigash|vayechi|shemot|vaera|bo|beshalach|yitro|mishpatim|terumah|tetzaveh|ki-tisa|vayakhel|pekudei|vayikra|tzav|shmini|tazria|metzora|achrei-mot|kedoshim|emor|behar|bechukotai|bamidbar|nasso|behaalotcha|shlach|korach|chukat|balak|pinchas|matot|masei|devarim|vaetchanan|eikev|reeh|shoftim|ki-teitzei|ki-tavo|nitzavim|vayeilech|haazinu|vezot-haberakhah|vayakhel-pekudei|tazria-metzora|achrei-mot-kedoshim|behar-bechukotai|chukat-balak|matot-masei|nitzavim-vayeilech)", "destination": "/library.html" },
    { "source": "/:parashah(bereshit|noach|lech-lecha|vayera|chayei-sara|toldot|vayetzei|vayishlach|vayeshev|miketz|vayigash|vayechi|shemot|vaera|bo|beshalach|yitro|mishpatim|terumah|tetzaveh|ki-tisa|vayakhel|pekudei|vayikra|tzav|shmini|tazria|metzora|achrei-mot|kedoshim|emor|behar|bechukotai|bamidbar|nasso|behaalotcha|shlach|korach|chukat|balak|pinchas|matot|masei|devarim|vaetchanan|eikev|reeh|shoftim|ki-teitzei|ki-tavo|nitzavim|vayeilech|haazinu|vezot-haberakhah|vayakhel-pekudei|tazria-metzora|achrei-mot-kedoshim|behar-bechukotai|chukat-balak|matot-masei|nitzavim-vayeilech)", "destination": "/library.html" },
    { "source": "/torah/:book(genesis|exodus|leviticus|numbers|deuteronomy)", "destination": "/library.html" },
    { "source": "/prophets/:book(joshua|judges|i-samuel|ii-samuel|i-kings|ii-kings|isaiah|jeremiah|ezekiel|hosea|joel|amos|obadiah|jonah|micah|nahum|habakkuk|zephaniah|haggai|zechariah|malachi)", "destination": "/library.html" },
    { "source": "/special/:tag(shuva|chazon|nachamu|shekalim|zachor|parah|hachodesh|hagadol|chanukah|rosh-chodesh|machar-chodesh|rosh-hashana|yom-kippur|sukkot|shmini-atzeret|pesach|shavuot)", "destination": "/library.html" }
  ],
  "headers": [
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] },
    { "source": "/((?!data/|api/|oauth/|\\.well-known/).*)", "headers": [{ "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' https://www.sefaria.org; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }] }
  ]
}
